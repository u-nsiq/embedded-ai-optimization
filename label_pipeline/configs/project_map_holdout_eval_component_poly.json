{
  "name": "project_map_holdout_eval_component_poly",
  "project_root": "<workspace-root>",
  "input": {
    "manifest_csv": "30_pipelines/culane_pseudo_dataset_builder/inputs/manifests/holdout_eval_candidate_manifest.csv",
    "raw_path_column": "raw_path",
    "label_column": "label",
    "path_prefix_map": {}
  },
  "output": {
    "dataset_root": "30_pipelines/culane_pseudo_dataset_builder/datasets/map_culane_holdout_eval_component_poly",
    "image_base": "driver_project_map_holdout_eval",
    "mask_base": "laneseg_label_w16"
  },
  "reports_dir": "30_pipelines/culane_pseudo_dataset_builder/reports",
  "camera": {
    "raw_width": 1296,
    "raw_height": 972,
    "cut_height": 445,
    "model_width": 800,
    "model_height": 320,
    "num_points": 72,
    "max_lanes": 4
  },
  "preprocess": {
    "crop_before_hsv": true
  },
  "hsv": {
    "lower": [22, 90, 110],
    "upper": [38, 255, 255],
    "morph_kernel": 5
  },
  "lane_extraction": {
    "method": "component_poly",
    "y_step": 6,
    "min_run_width": 4,
    "min_points": 8,
    "min_area": 450,
    "min_height": 120,
    "degree": 2
  },
  "review_priority_policy": {
    "field1_sign_background": "high",
    "field2_traffic_background": "high"
  },
  "quality_gate": {
    "min_lanes": 1,
    "min_point_total": 12,
    "min_y_span": 80,
    "min_mask_support": 0.2,
    "reject_crossing": false,
    "reject_small_gap": false
  },
  "build": {
    "train_ratio": 0.8,
    "max_per_scene": null
  },
  "review": {
    "max_overlays": 200,
    "save_usable_every": 10
  },
  "mask_thickness": 10
}
